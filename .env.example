# DATABASE_URL=postgresql+psycopg2://refund:refund@localhost:5432/refunds   # default: local SQLite file
# LLM_API_KEY=...                       # optional: turns the 3 agents from rule-based fallback into LLM-assisted (any OpenAI-compatible provider)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# CLAIM_NLP=transformer   SENTIMENT_MODEL=...   IMAGE_TEXT=clip   COST_SCALE=1.0     # see requirements-nlp.txt and README

# ---- recommended settings from docs/decisions.md (copy the lines you want into the real environment) ----
# COST_SCALE=0.1                                                    # a manual review costs ~10 units; set from the real review cost / 100
# SENTIMENT_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment-multilingual   # needs requirements-nlp.txt; customer-experience routing only
# CLAIM_NLP=rules                                                   # the rules beat the zero-shot transformer on the developer-labelled set
